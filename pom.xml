<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/>
    </parent>

    <groupId>dev.sagacity</groupId>
    <artifactId>sagacity-quickstart</artifactId>
    <version>1.0.0</version>
    <name>Sagacity Quickstart</name>
    <description>
        A runnable demo of Sagacity — human oversight and audit for Spring AI agents.
        No API key required. Four scenarios showing approval gates, auto-unwind on
        rejection, and automatic compensation. Clone and run in under 60 seconds.
    </description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot web — serves /sagacity/ui and REST endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Sagacity — governance layer for Spring AI agents -->
        <dependency>
            <groupId>io.github.sumitvairagar</groupId>
            <artifactId>sagacity-spring-boot-starter</artifactId>
            <version>0.4.0</version>
        </dependency>

        <!-- Sagacity Workflows — @Workflow, @Stage, @Gate, @Check -->
        <dependency>
            <groupId>io.github.sumitvairagar</groupId>
            <artifactId>sagacity-workflows</artifactId>
            <version>0.4.0</version>
        </dependency>

        <!-- Jackson — required by JdbcWorkflowRunStore for stage output serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
            Spring AI — optional, only needed for real LLM scenarios.
            The default demo runs without an API key using direct tool calls.
            Uncomment to enable real OpenAI calls:
        -->
        <!--
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
